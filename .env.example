# Server Configuration
PORT=8080

# Public site URL (canonical links, sitemap, Open Graph). Set to your production domain.
SITE_BASE_URL=https://your-domain.example.com

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgres://postgres:[YOUR_PASSWORD]@db.xkzadsnvjdrspymgcoaq.supabase.co:5432/postgres

# Used when APP_ENV=development (`go run`, Air). docker compose overrides this
# to postgres://postgres:postgres@db:5432/infolinks?sslmode=disable inside the app container.
LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/infolinks?sslmode=disable

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=supabase-publishable-key

# Security
JWT_SECRET=generate-a-secure-random-string-here
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Shared secret Cloudflare injects as X-Cloudflare-Secret toward origin.
# When set, direct *.onrender.com traffic without this header is rejected (403).
# Leave unset for local development. /healthz, /readyz, and /metrics stay exempt.
CF_SECRET_TOKEN=

# Prometheus / Grafana Cloud scrape auth (required when APP_ENV=production)
METRICS_BASIC_AUTH_USER=grafana-scraper
METRICS_BASIC_AUTH_PASSWORD=generate-a-long-random-password-here
